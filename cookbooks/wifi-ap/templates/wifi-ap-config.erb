#!/bin/sh
# vim: set noet :

set -eu

DEVICE='/dev/disk/by-label/<%= node[:wifi_ap][:credentials][:label] %>'
CREDENTIALS='<%= node[:wifi_ap][:credentials][:path] %>'
DEFAULTS='/etc/wifi-ap/credentials.conf'
BASE='/etc/wifi-ap/hostapd.conf'
OUTPUT='<%= @runtime_conf %>'

SSID=
PASSPHRASE=

# A value the file does not set keeps the one read before.
read_credentials() {
	# Editors on Windows save CRLF line endings, and some prepend a BOM.
	CONTENT="$(sed -e '1s/^\xEF\xBB\xBF//' -e 's/\r$//' "$1")"

	while IFS= read -r LINE; do
		case "${LINE}" in
			ssid=*)
				SSID="${LINE#ssid=}"
				;;
			wpa_passphrase=*)
				PASSPHRASE="${LINE#wpa_passphrase=}"
				;;
		esac
	done <<- __EOF__
	${CONTENT}
	__EOF__
}

rm -f "${OUTPUT}"

read_credentials "${DEFAULTS}"

# A network boot has no boot medium, and keeps the credentials in the image.
if udevadm wait --timeout=10 "${DEVICE}"; then
	# toram releases the boot medium after the copy, so mount it again here.
	MOUNT="$(mktemp -d)"
	trap 'umount "${MOUNT}" 2>/dev/null || true; rmdir "${MOUNT}"' EXIT
	if mount -t vfat -o ro,nodev,nosuid,noexec "${DEVICE}" "${MOUNT}" && [ -f "${MOUNT}/${CREDENTIALS}" ]; then
		echo "Reading ${CREDENTIALS} on ${DEVICE}" >&2
		read_credentials "${MOUNT}/${CREDENTIALS}"
	fi
fi

# dash counts bytes, which is what the SSID limit is in.
if [ "${#SSID}" -lt 1 ] || [ "${#SSID}" -gt 32 ]; then
	echo "ssid must be 1 to 32 bytes" >&2
	exit 1
fi

if [ "${#PASSPHRASE}" -lt 8 ] || [ "${#PASSPHRASE}" -gt 63 ]; then
	echo "wpa_passphrase must be 8 to 63 characters" >&2
	exit 1
fi

mkdir -p "$(dirname "${OUTPUT}")"
umask 077
{
	cat "${BASE}"
	printf 'ssid=%s\n' "${SSID}"
	printf 'wpa_passphrase=%s\n' "${PASSPHRASE}"
} > "${OUTPUT}.tmp"
mv "${OUTPUT}.tmp" "${OUTPUT}"
